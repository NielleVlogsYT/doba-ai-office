# Copy to .env. Wrangler reads .env and .env.local for local development;
# both are git-ignored. On Freebuff Cloud, add OPENAI_API_KEY under
# Settings → Secrets. On Freebuff Sites, set it in Sites → Secrets.

# A Groq API key (starts with gsk_). Create one free at https://console.groq.com/keys.
# Without a key the office runs on scripted demo replies.
OPENAI_API_KEY=

# The OpenAI-compatible API the office talks to. Defaults to the Freebuff API
# when unset; this project is wired to Groq.
OPENAI_BASE_URL=https://api.groq.com/openai/v1
