{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bullpen",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-29",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  // Local secrets come from `.env` (see .env.example): OPENAI_API_KEY is the
  // Freebuff API key. Do not add a `.dev.vars` file; its presence stops
  // Wrangler from reading `.env` and `.env.local`.
  "observability": { "enabled": true }
}
